# ============================================================================
#  InfoDevis — .env (SECRETS)  •  MODÈLE
#  Copier ce fichier en « .env », remplir les valeurs, le déposer dans /www
#  à côté de wp-config.php.  NE JAMAIS committer le .env rempli.
#  Le .htaccess bloque déjà l'accès HTTP direct à ce fichier.
# ============================================================================

# ── Base de données (console online.net → Bases MySQL) ──
DB_NAME=info_devis
DB_USER=
DB_PASSWORD=
DB_HOST=

# ── Clés de sécurité WordPress ──
# Générer 8 valeurs uniques : https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# ── Stripe (clés LIVE — laisser vide tant que les paiements ne sont pas activés) ──
STRIPE_PUBLIC=
STRIPE_SECRET=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
STRIPE_WEBHOOK_SECRET=

# ── SMTP (Brevo — laisser SMTP_USER vide pour désactiver l'envoi SMTP) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
